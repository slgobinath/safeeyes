          }
        }
      }
    },
    "Close your eyes gently, pause for 2 seconds, then open slowly. Repeat 4 times.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close your eyes gently, pause for 2 seconds, then open slowly. Repeat 4 times."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق عينيك بلطف، انتظر ثانيتين، ثم افتحهما ببطء. كرر ذلك 4 مرات."
          }
        }
      }
    },
