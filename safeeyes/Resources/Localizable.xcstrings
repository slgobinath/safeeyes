    "Roll your eyes slowly in a circle clockwise, then switch to counter-clockwise.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll your eyes slowly in a circle clockwise, then switch to counter-clockwise."
