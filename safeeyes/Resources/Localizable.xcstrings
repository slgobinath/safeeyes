    "Hold your thumb 10 inches from your face. Focus on it for 5 seconds, then focus on a distant point.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your thumb 10 inches from your face. Focus on it for 5 seconds, then focus on a distant point."
