        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع إبهامك على بعد 25 سم من وجهك وركز عليه لمدة 5 ثوانٍ، ثم ركز على نقطة بعيدة."
          }
        }
      }
    },
